{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 0 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
